# Copy this file to `.env` (which is gitignored) and fill in real values,
# or export these as real environment variables / secrets in your scheduler.
# Never commit real API keys.

# Coinbase Developer Platform (CDP) API key, from https://portal.cdp.coinbase.com/
# Format: "organizations/{org_id}/apiKeys/{key_id}"
COINBASE_API_KEY=
# The private key downloaded alongside it (PEM format).
COINBASE_API_SECRET=

# Coinbase has NO paper-trading sandbox. This is required to submit ANY
# order, not just to opt into a "live" mode -- must be exactly "yes".
# I_CONFIRM_LIVE_TRADING=yes

# Optional. If set, run_live_trading.py researches each proposed order with
# a short web search before you decide whether to --execute (see research.py).
# Purely informational -- omit this and pass --skip-research to disable it.
# ANTHROPIC_API_KEY=
