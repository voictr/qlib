# Copy this file to `.env` (which is gitignored) and fill in real values,
# or export these as real environment variables / secrets in your scheduler.
# Never commit real API keys.

# From https://app.alpaca.markets/paper/dashboard/overview (paper) or the
# live dashboard. Paper and live keys are DIFFERENT keys.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# "paper" (default, recommended) or "live".
ALPACA_TRADING_MODE=paper

# Only read when ALPACA_TRADING_MODE=live. Must be exactly "yes".
# This is a deliberate extra step so live trading can never be turned on
# by accident via a stray/misremembered env var.
# I_CONFIRM_LIVE_TRADING=yes
